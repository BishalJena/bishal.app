{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Main site = Cloudflare Pages project "bishal-app-pages" (Git-connected: every push to main deploys).
  // Domains bishal.app + www are attached to the Pages project in the dashboard.
  // /lotus-* is served by the separate lotus-waitlists Worker (apple-cta-websites repo).
  "name": "bishal-app-pages",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": "./public"
}
